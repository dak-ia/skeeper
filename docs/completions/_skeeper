_skeeper__subcmd__help__subcmd__new_commands() {
    local commands; commands=()
    _describe -t commands 'skeeper help new commands' commands "$@"
}
(( $+functions[_skeeper__subcmd__help__subcmd__prune_commands] )) ||
_skeeper__subcmd__help__subcmd__prune_commands() {
    local commands; commands=()
    _describe -t commands 'skeeper help prune commands' commands "$@"
}
(( $+functions[_skeeper__subcmd__help__subcmd__rename_commands] )) ||
_skeeper__subcmd__help__subcmd__rename_commands() {
    local commands; commands=()
    _describe -t commands 'skeeper help rename commands' commands "$@"
}
(( $+functions[_skeeper__subcmd__kill_commands] )) ||
_skeeper__subcmd__kill_commands() {
    local commands; commands=()
    _describe -t commands 'skeeper kill commands' commands "$@"
}
(( $+functions[_skeeper__subcmd__list_commands] )) ||
_skeeper__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'skeeper list commands' commands "$@"
}
(( $+functions[_skeeper__subcmd__new_commands] )) ||
_skeeper__subcmd__new_commands() {
